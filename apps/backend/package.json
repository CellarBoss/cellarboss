{
  "name": "@cellarboss/backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/src/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "auth:migrate": "auth migrate --yes --config ./dist/src/utils/auth.js",
    "migrate": "tsx src/utils/migrate.ts latest",
    "migrate:down": "tsx src/utils/migrate.ts down",
    "seed": "tsx src/utils/seed-cli.ts",
    "generate:docs": "tsx scripts/generate-docs.ts",
    "import:recon": "tsx scripts/import-recon.ts",
    "lint": "eslint --max-warnings 0"
  },
  "dependencies": {
    "@cellarboss/types": "workspace:*",
    "@cellarboss/validators": "workspace:*",
    "@hono/mcp": "0.3.2",
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@hono/zod-validator": "0.9.1",
    "@loglayer/hono": "2.4.0",
    "@loglayer/transport-pino": "3.3.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@scalar/hono-api-reference": "0.12.9",
    "auth": "1.7.7",
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "dotenv": "18.0.5",
    "fuse.js": "7.5.0",
    "hono": "4.13.12",
    "ipaddr.js": "2.5.0",
    "kysely": "0.29.6",
    "kysely-ctl": "0.21.0",
    "loglayer": "9.4.0",
    "mysql2": "3.24.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "serialize-error": "13.0.1",
    "sharp": "0.35.4",
    "undici": "7.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "domhandler": "6.0.1",
    "eslint": "10.11.0",
    "globals": "16.5.0",
    "pino-pretty": "13.1.3",
    "playwright-core": "1.63.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
