{
  "name": "@cellarboss/validators",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cellarboss/types": "workspace:*",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
