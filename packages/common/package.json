{
  "name": "@cellarboss/common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "dependencies": {
    "@cellarboss/types": "workspace:*",
    "@cellarboss/validators": "workspace:*",
    "date-fns": "4.4.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "@tanstack/react-query": ">=5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react": "catalog:",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
