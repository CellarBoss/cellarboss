{
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "node -e \"if(!process.env.CI)require('node:child_process').execSync('lefthook install',{stdio:'inherit'})\""
  },
  "lint-staged": {
    "*.{ts,tsx,md}": "prettier --write"
  },
  "devDependencies": {
    "lefthook": "2.1.14",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8"
  }
}
